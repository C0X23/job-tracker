{$DOMAIN} {
    encode gzip zstd

    header {
        # HSTS handled by Django via SECURE_HSTS_*; Caddy adds basic hardening
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }

    # Static files: volume mounted at /app/staticfiles, URL prefix /static/
    # handle_path strips the prefix before file_server resolves the path.
    handle_path /static/* {
        root * /app/staticfiles
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Media files: volume mounted at /app/media, URL prefix /media/
    handle_path /media/* {
        root * /app/media
        file_server
        header Cache-Control "public, max-age=86400"
    }

    # Everything else proxies to gunicorn
    reverse_proxy web:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }

    log {
        output stdout
        format json
        level INFO
    }
}
