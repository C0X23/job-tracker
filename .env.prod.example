# Production environment — copy to .env.prod on the server and fill in
# Never commit .env.prod

# Django
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-50
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=job-tracker.cmegret.com
CSRF_TRUSTED_ORIGINS=https://job-tracker.cmegret.com

# Caddy (referenced as {$DOMAIN} in Caddyfile)
DOMAIN=job-tracker.cmegret.com

# Database (POSTGRES_* are read by both the postgres image and the backup service)
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://jobtracker:change-me-strong-password@db:5432/jobtracker

# Static / media
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
